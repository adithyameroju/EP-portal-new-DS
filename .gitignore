# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

.yalc
yalc.lock

# drift ledger (S4 audit loop): entries are COMMITTED evidence;
# reports + dashboard are derived artifacts — regenerate with
# `npm run audit:compliance` / `npm run dashboard` (owner decision 2026-07-06)
/drift-log/reports/*.json
/drift-log/dashboard.html
/drift-log/detect/
# note: drift-log/entries/ and drift-log/proposals/ ARE committed (evidence trail)
# package build output (S3 — `npm run build:pkg`); derived artifact, never committed
/dist/
# npm pack tarballs (keep out of the repo; pack to /private/tmp)
*.tgz
