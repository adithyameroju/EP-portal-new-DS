{
  "name": "@acko/compass",
  "version": "0.1.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fonts.css": "./app/fonts.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "compass": "./cli/compass.mjs"
  },
  "files": [
    "dist",
    "app/fonts.css",
    "app/fonts",
    "cli",
    "components/ui",
    ".claude/specs",
    ".claude/skills",
    "CLAUDE.md",
    "scripts/token-audit.mjs",
    "scripts/compliance-audit.mjs",
    "scripts/audit-rubric.json",
    "app/globals.css",
    "lib/PACKAGING.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pkg": "tsup && node -e \"const fs=require('fs');fs.writeFileSync('dist/package.json',JSON.stringify({type:'module'},null,2)+'\\n');fs.copyFileSync('dist/index.d.ts','dist/index.d.cts')\"",
    "start": "next start",
    "lint": "eslint",
    "audit": "node scripts/token-audit.mjs",
    "audit:compliance": "node scripts/compliance-audit.mjs",
    "log": "node scripts/compass-log.mjs",
    "dashboard": "node scripts/generate-dashboard.mjs",
    "detect": "node scripts/detect-drift.mjs",
    "prescribe": "node scripts/prescribe.mjs",
    "figma-publish": "figma connect publish --skip-validation",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --build-script-name build-storybook --exit-zero-on-changes"
  },
  "dependencies": {
    "@acko/enterprise-tokens": "^1.0.0",
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@figma/code-connect": "^1.4.3",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-storybook": "^10.3.6",
    "playwright": "^1.60.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "next": "16.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^16.0.0"
  }
}
